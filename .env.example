# Used by the CLI scripts (scripts/*.ts) run locally via `tsx`.
# The Worker reads the same values from `wrangler secret put` instead of this file.

# Calendly personal access token (paid plan needed for webhooks).
# Get it at: https://calendly.com/integrations/api_webhooks
CALENDLY_PAT=cal_pat_...

# Optional: pin the Calendly user/organization the integration scopes to.
# If unset, scripts resolve via GET /users/me.
CALENDLY_USER_URI=
CALENDLY_ORG_URI=

# Public URL of your deployed Cloudflare Worker — used when registering the webhook.
WORKER_URL=https://calendly-notion-sync.<your-subdomain>.workers.dev

# Calendly will sign every webhook delivery using this shared secret.
# You create the value (any high-entropy string) and pass it when registering
# the subscription; Calendly hashes payloads with it.
CALENDLY_WEBHOOK_SIGNING_KEY=replace-with-a-long-random-string

# Notion integration token — create at https://www.notion.so/profile/integrations
# Internal integration, give it edit access to the 4 TNN databases.
NOTION_TOKEN=secret_...

# Database IDs — pre-filled with TNN's IDs (classic API queries by database_id).
NOTION_GROUPS_DB_ID=94a4bd87da2c8316b730017be96ea0a9
NOTION_TRAINING_DB_ID=baa4bd87da2c82b28944817054de4bfc
NOTION_VOLUNTEERS_DB_ID=c3f4bd87da2c82e6a07f01475d133397
NOTION_API_VERSION=2022-06-28
